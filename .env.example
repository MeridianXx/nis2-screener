# Anthropic API — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Postgres — Neon connection strings (auto-injected by the Vercel Neon integration)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/dbname?sslmode=require

# Roaring — OAuth2 client credentials from https://developer.roaring.io
# Sandbox keys return fictional data and are free; production keys cost.
ROARING_CLIENT_ID=
ROARING_CLIENT_SECRET=
ROARING_BASE_URL=https://api.roaring.io
# Optional overrides — defaults work against Roaring's standard products.
# Override if your sandbox subscription only includes a different API.
# ROARING_TOKEN_URL=https://api.roaring.io/token
# ROARING_SEARCH_PATH=/companysearch/2.0/companies?nameContaining={q}&maxHits={limit}
# ROARING_COMPANY_PATH=/companyinformation/2.0/companies/{orgnr}
# Set to "true" to log outgoing Roaring URLs and a 800-char preview of each
# response into Vercel function logs. Useful while iterating on endpoints.
ROARING_DEBUG=false

# Feature flags
NEXT_PUBLIC_USE_MOCK_COMPANY_DATA=true
