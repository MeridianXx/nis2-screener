# Anthropic API — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Postgres — Neon connection strings (auto-injected by the Vercel Neon integration)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/dbname?sslmode=require

# Apiverket — Bearer token from https://apiverket.se. Free tier covers
# 200 lookups/day; production keys are cheap. The sk_test_demo123 key is
# intended for local development only.
APIVERKET_API_KEY=sk_test_demo123

# Feature flags
NEXT_PUBLIC_USE_MOCK_COMPANY_DATA=true
