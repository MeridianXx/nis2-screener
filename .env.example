# Anthropic API — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Postgres — Neon connection strings (auto-injected by the Vercel Neon integration)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/dbname?sslmode=require

# Roaring — OAuth2 client credentials from https://developer.roaring.io
# Sandbox keys return fictional data and are free; production keys cost.
ROARING_CLIENT_ID=
ROARING_CLIENT_SECRET=
ROARING_BASE_URL=https://api.roaring.io
# Optional override; defaults to ${ROARING_BASE_URL}/token
# ROARING_TOKEN_URL=

# Feature flags
NEXT_PUBLIC_USE_MOCK_COMPANY_DATA=true
