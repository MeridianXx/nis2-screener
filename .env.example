# Anthropic API — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Postgres — Vercel Postgres or Neon
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Roaring API — company data (v1.1, leave blank for v1 with mock data)
ROARING_API_KEY=
ROARING_BASE_URL=https://api.roaring.io

# Feature flags
NEXT_PUBLIC_USE_MOCK_COMPANY_DATA=true
